# Copy this server block into your nginx configuration and update server_name,
# root, and fastcgi_pass for your host.
#
# After copying: sudo nginx -t && sudo systemctl reload nginx
#
# /              → Touro website (src/index.php)
# /links/        → signed-in link manager
# /login/        → login
# /admin/users/  → user admin
# /admissions    → short-link redirect
server {
    listen 80;
    server_name tou.ro;
    root /var/www/touro/src;
    index index.php;

    location = / {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location = /admin {
        return 302 /links/;
    }

    location = /admin/ {
        return 302 /links/;
    }

    # Never serve application secrets, data, or shared PHP/template source.
    location ~ (?:^|/)\.env(?:\.|/|$) {
        deny all;
    }

    location ^~ /db/ {
        deny all;
    }

    location ^~ /templates/ {
        deny all;
    }

    location = /lib.php {
        deny all;
    }

    location = /router.php {
        deny all;
    }

    # Use index.php inside a folder. "$uri/" is a directory listing and 403s.
    location /admin/ {
        try_files $uri $uri/index.php =404;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    # App folders (/login/, /links/, …) or unknown short-link slugs.
    location / {
        try_files $uri $uri/index.php /redirects/index.php?$query_string;
    }

    location = /redirects/index.php {
        internal;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/redirects/index.php;
        fastcgi_param SCRIPT_NAME /redirects/index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
}
