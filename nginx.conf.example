# One hostname: tou.ro
#
#   /              → https://www.touro.edu  (src/index.php)
#   /login/        → sign in
#   /links/        → create and manage short links
#   /stories       → short-link redirect
#
# After copying: sudo nginx -t && sudo systemctl reload nginx
# Check the socket with: ls /run/php/

server {
    listen 80;
    listen 443 ssl;
    server_name tou.ro www.tou.ro;
    root /var/www/touro/src;
    index index.php;

    # ssl_certificate     /etc/letsencrypt/live/tou.ro/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/tou.ro/privkey.pem;

    location = / {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location = /admin {
        return 302 /links/;
    }

    location = /admin/ {
        return 302 /links/;
    }

    location ~ (?:^|/)\.env(?:\.|/|$) { deny all; }
    location ^~ /db/ { deny all; }
    location ^~ /templates/ { deny all; }
    location = /lib.php { deny all; }
    location = /router.php { deny all; }

    location /admin/ {
        try_files $uri $uri/index.php =404;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    # Use $uri/index.php, not $uri/. Never return $uri/links/ (that becomes //links/).
    location / {
        try_files $uri $uri/index.php /redirects/index.php?$query_string;
    }

    location = /redirects/index.php {
        internal;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/redirects/index.php;
        fastcgi_param SCRIPT_NAME /redirects/index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
}
