# Copy this server block into your nginx configuration and update server_name,
# root, and fastcgi_pass for your host.
server {
    listen 80;
    server_name tou.ro;
    root /var/www/touro/src;
    index index.php;

    location = / {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location = /admin {
        return 302 /;
    }

    location = /admin/ {
        return 302 /;
    }

    # Never serve application secrets, data, or shared PHP/template source.
    location ~ (?:^|/)\.env(?:\.|/|$) {
        deny all;
    }

    location ^~ /db/ {
        deny all;
    }

    location ^~ /templates/ {
        deny all;
    }

    location = /lib.php {
        deny all;
    }

    location = /router.php {
        deny all;
    }

    # Signed-in app pages and admin tools are real files under src/.
    location /admin/ {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    # Unknown root paths are short-link slugs.
    location / {
        try_files $uri $uri/ /redirects/index.php?$query_string;
    }

    location = /redirects/index.php {
        internal;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/redirects/index.php;
        fastcgi_param SCRIPT_NAME /redirects/index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
}
